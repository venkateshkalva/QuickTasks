document.addEventListener("DOMContentLoaded", function () {

    const switchElement = document.getElementById("selectAllNoSwitch");

    // ---------------------------------
    // SWITCH MANUALLY CHANGED
    // ---------------------------------
    switchElement.addEventListener("change", function () {

        if (this.checked) {

            // Switch ON
            // Set all applicable questions to No (value = 2)
            document.querySelectorAll(
                'input[type="radio"][value="2"]:not(.exclude-select-all)'
            ).forEach(radio => {
                radio.checked = true;
            });

        } else {

            // Switch OFF
            // Clear all currently selected No answers
            document.querySelectorAll(
                'input[type="radio"][value="2"]:checked:not(.exclude-select-all)'
            ).forEach(radio => {
                radio.checked = false;
            });
        }
    });


    // ---------------------------------
    // RADIO MANUALLY CHANGED
    // ---------------------------------
    document.querySelectorAll(
        'input[type="radio"]:not(.exclude-select-all)'
    ).forEach(radio => {

        radio.addEventListener("change", function () {

            // User manually changed any question
            // Turn the "All No" switch OFF
            switchElement.checked = false;

        });

    });

});
