const selectedDocumentsKey = "selectedDocuments";


// ============================================================
// SELECT / UNSELECT ALL
// ============================================================

$(document).on("change", "#chkSelectAll", function () {

    const isChecked = $(this).is(":checked");

    let selectedDocuments = getSelectedDocuments();

    $(".doc-checkbox").each(function () {

        const checkbox = $(this);

        const docId = Number(checkbox.data("docid"));
        const hhId = Number(checkbox.data("hhid"));

        checkbox.prop("checked", isChecked);

        if (isChecked) {

            // Add only if it doesn't already exist
            const alreadyExists =
                selectedDocuments.some(
                    x => x.docId === docId
                );

            if (!alreadyExists) {

                selectedDocuments.push({
                    docId: docId,
                    hhId: hhId
                });
            }

        } else {

            // Remove this row
            selectedDocuments =
                selectedDocuments.filter(
                    x => x.docId !== docId
                );
        }
    });

    saveSelectedDocuments(selectedDocuments);
});


// ============================================================
// INDIVIDUAL CHECKBOX
// ============================================================

$(document).on("change", ".doc-checkbox", function () {

    const docId = Number($(this).data("docid"));
    const hhId = Number($(this).data("hhid"));

    if ($(this).is(":checked")) {

        addSelectedDocument(
            docId,
            hhId
        );

    } else {

        removeSelectedDocument(
            docId
        );
    }

    updateSelectAllCheckbox();
});


// ============================================================
// UPDATE SELECT ALL STATE
// ============================================================

function updateSelectAllCheckbox() {

    const total =
        $(".doc-checkbox").length;

    const checked =
        $(".doc-checkbox:checked").length;

    $("#chkSelectAll").prop(
        "checked",
        total > 0 && total === checked
    );
}


// ============================================================
// GET FROM LOCAL STORAGE
// ============================================================

function getSelectedDocuments() {

    const storedArray =
        localStorage.getItem(
            selectedDocumentsKey
        );

    if (!storedArray) {
        return [];
    }

    try {

        const data =
            JSON.parse(storedArray);

        if (!Array.isArray(data)) {
            return [];
        }

        return data.filter(x =>
            x &&
            Number(x.docId) > 0 &&
            Number(x.hhId) > 0
        );

    } catch {

        localStorage.removeItem(
            selectedDocumentsKey
        );

        return [];
    }
}


// ============================================================
// ADD ONE DOCUMENT
// ============================================================

function addSelectedDocument(
    docId,
    hhId
) {

    let selectedDocuments =
        getSelectedDocuments();

    const alreadyExists =
        selectedDocuments.some(
            x => x.docId === docId
        );

    if (!alreadyExists) {

        selectedDocuments.push({
            docId: docId,
            hhId: hhId
        });
    }

    saveSelectedDocuments(
        selectedDocuments
    );
}


// ============================================================
// REMOVE ONE DOCUMENT
// ============================================================

function removeSelectedDocument(
    docId
) {

    let selectedDocuments =
        getSelectedDocuments();

    selectedDocuments =
        selectedDocuments.filter(
            x => x.docId !== docId
        );

    saveSelectedDocuments(
        selectedDocuments
    );
}


// ============================================================
// SAVE + UPDATE ASP.NET BINDING INPUTS
// ============================================================

function saveSelectedDocuments(
    selectedDocuments
) {

    localStorage.setItem(
        selectedDocumentsKey,
        JSON.stringify(
            selectedDocuments
        )
    );

    updateSelectedDocumentInputs(
        selectedDocuments
    );
}


// ============================================================
// GENERATE HIDDEN INPUTS
// ============================================================

function updateSelectedDocumentInputs(
    selectedDocuments
) {

    const container =
        $("#selectedDocumentsContainer");

    container.empty();

    selectedDocuments.forEach(
        (item, index) => {

            container.append(`
                <input type="hidden"
                       name="SelectedDocuments[${index}].DocId"
                       value="${item.docId}" />

                <input type="hidden"
                       name="SelectedDocuments[${index}].HHId"
                       value="${item.hhId}" />
            `);
        }
    );
}


// ============================================================
// RESTORE CHECKBOXES
// ============================================================

function restoreCheckboxes() {

    const selectedDocuments =
        getSelectedDocuments();

    $(".doc-checkbox").each(function () {

        const docId =
            Number(
                $(this).data("docid")
            );

        const isSelected =
            selectedDocuments.some(
                x => x.docId === docId
            );

        $(this).prop(
            "checked",
            isSelected
        );
    });

    updateSelectedDocumentInputs(
        selectedDocuments
    );

    updateSelectAllCheckbox();
}


// ============================================================
// PAGE LOAD
// ============================================================

$(document).ready(function () {

    restoreCheckboxes();

});
