document.addEventListener("DOMContentLoaded", function () {

    const switchElement = document.getElementById("selectAllNoSwitch");

    if (!switchElement) return;

    // Tells us that radio changes are coming from the switch
    let changingFromSwitch = false;


    // =====================================================
    // CHECK IF ALL QUESTIONS ARE NO (value = 2)
    // =====================================================
    function areAllQuestionsNo() {

        const radios = document.querySelectorAll(
            'input[type="radio"]:not(.exclude-select-all)'
        );

        const groupNames = [
            ...new Set(
                [...radios]
                    .map(radio => radio.name)
                    .filter(Boolean)
            )
        ];

        if (groupNames.length === 0) {
            return false;
        }

        return groupNames.every(groupName => {

            const checkedRadio = document.querySelector(
                `input[type="radio"][name="${groupName}"]:checked:not(.exclude-select-all)`
            );

            return checkedRadio?.value === "2";
        });
    }


    // =====================================================
    // PAGE LOAD
    // =====================================================
    switchElement.checked = areAllQuestionsNo();


    // =====================================================
    // SWITCH CHANGE
    // =====================================================
    switchElement.addEventListener("change", function () {

        changingFromSwitch = true;

        if (this.checked) {

            // ---------------------------------------------
            // SWITCH ON -> Set all to NO (value = 2)
            // ---------------------------------------------
            document.querySelectorAll(
                'input[type="radio"][value="2"]:not(.exclude-select-all)'
            ).forEach(radio => {

                // Check the radio
                radio.checked = true;

                // IMPORTANT:
                // Trigger change so your existing Razor/JS
                // logic also gets updated
                radio.dispatchEvent(
                    new Event("change", { bubbles: true })
                );

            });

        } else {

            // ---------------------------------------------
            // SWITCH OFF -> Clear selected NO answers
            // ---------------------------------------------
            document.querySelectorAll(
                'input[type="radio"][value="2"]:checked:not(.exclude-select-all)'
            ).forEach(radio => {

                radio.checked = false;

                radio.dispatchEvent(
                    new Event("change", { bubbles: true })
                );

            });
        }

        changingFromSwitch = false;
    });


    // =====================================================
    // RADIO CHANGE
    // =====================================================
    document.querySelectorAll(
        'input[type="radio"]:not(.exclude-select-all)'
    ).forEach(radio => {

        radio.addEventListener("change", function () {

            // Radio was changed by Select All switch.
            // Don't modify the switch.
            if (changingFromSwitch) {
                return;
            }

            // Radio was manually changed by user.
            // Recalculate switch state.
            switchElement.checked = areAllQuestionsNo();

        });

    });

});
