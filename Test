
int repid = TempData.Peek("repID") is int id ? id : 0;

int? currentClaimantid =
    TempData.Peek("currentPlaintiffID") is int claimantId
        ? claimantId
        : null;

string currentPlaintiffType =
    TempData.Peek("currentPlaintiffType") as string;

if (!string.IsNullOrWhiteSpace(ReleaseEmailObj?.EmailID))
{
    string email = ReleaseEmailObj.EmailID.Trim();

    bool emailExists;

    if (repid > 0)
    {
        // MINOR INDIVIDUAL / BUSINESS / TRUST
        //
        // Allow same email across different claimants.
        // Block duplicate email for different representatives
        // within the SAME claimant.
        // Allow resend to the current representative.

        emailExists = PlaintiffPageModelDS.SignatureDetails.Any(x =>

            x.ClaimantID == currentClaimantid &&

            x.ClaimantRepInfoID.HasValue &&
            x.ClaimantRepInfoID.Value > 0 &&

            x.ClaimantRepInfoID.Value != repid &&

            !string.IsNullOrWhiteSpace(x.EmailSentDate) &&

            string.Equals(
                x.EmailID?.Trim(),
                email,
                StringComparison.OrdinalIgnoreCase)
        );
    }
    else
    {
        // REGULAR INDIVIDUAL
        //
        // Only compare against other regular Individuals.
        // Exclude Minor, Business, Trust representatives.
        // Allow resend for the current claimant.

        emailExists = PlaintiffPageModelDS.SignatureDetails.Any(x =>

            (!x.ClaimantRepInfoID.HasValue ||
             x.ClaimantRepInfoID.Value == 0) &&

            x.ClaimantID != currentClaimantid &&

            x.ClaimantType == currentPlaintiffType &&

            !string.IsNullOrWhiteSpace(x.EmailSentDate) &&

            string.Equals(
                x.EmailID?.Trim(),
                email,
                StringComparison.OrdinalIgnoreCase)
        );
    }

    if (emailExists)
    {
        ShowEmailInfoPopup = true;

        CustomEmailPopupErrorMessage =
            "A verification email has already been sent " +
            "to this address for another recipient.";

        return Page();
    }
}

