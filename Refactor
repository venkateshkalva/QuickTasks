            parentXmlString.Append(GenerateTag("ObservedJan31YNID", LQDetailInfoObj.ObservedJan31YNID));
            parentXmlString.Append(GenerateTag("ObservedJan31Desc", LQDetailInfoObj.ObservedJan31Desc));
            parentXmlString.Append(GenerateTag("ObservedJan7YNID", LQDetailInfoObj.ObservedJan7YNID));
            parentXmlString.Append(GenerateTag("ObservedJan7Desc", LQDetailInfoObj.ObservedJan7Desc));
            parentXmlString.Append(GenerateTag("OutageYNID", LQDetailInfoObj.OutageYNID));
            parentXmlString.Append(GenerateTag("OutageDesc", LQDetailInfoObj.OutageDesc));
            parentXmlString.Append(GenerateTag("PoleBeforeFireYNID", LQDetailInfoObj.PoleBeforeFireYNID));
            parentXmlString.Append(GenerateTag("PoleBeforeFireDesc", LQDetailInfoObj.PoleBeforeFireDesc));
            parentXmlString.Append(GenerateTag("PoleWitnessYNID", LQDetailInfoObj.PoleWitnessYNID));
            parentXmlString.Append(GenerateTag("PoleWitnessDesc", LQDetailInfoObj.PoleWitnessDesc));
            parentXmlString.Append(GenerateTag("PoleEyeWitnessYNID", LQDetailInfoObj.PoleEyeWitnessYNID));
            parentXmlString.Append(GenerateTag("PoleEyeWitnessDesc", LQDetailInfoObj.PoleEyeWitnessDesc));
            parentXmlString.Append(GenerateTag("WaterProviderYNID", LQDetailInfoObj.WaterProviderYNID));
