@page
@model YourNamespace.Pages.DocumentManagementModel

<form method="post">

    <!-- Hidden inputs for ASP.NET Core model binding -->
    <div id="selectedDocumentsContainer"></div>

    <!-- Example table -->
    <table class="table">
        <thead>
            <tr>
                <th>Select</th>
                <th>Doc ID</th>
                <th>HH ID</th>
            </tr>
        </thead>

        <tbody>
            <tr>
                <td>
                    <input type="checkbox"
                           class="doc-checkbox"
                           data-docid="1"
                           data-hhid="999" />
                </td>
                <td>1</td>
                <td>999</td>
            </tr>

            <tr>
                <td>
                    <input type="checkbox"
                           class="doc-checkbox"
                           data-docid="2"
                           data-hhid="888" />
                </td>
                <td>2</td>
                <td>888</td>
            </tr>

            <tr>
                <td>
                    <input type="checkbox"
                           class="doc-checkbox"
                           data-docid="3"
                           data-hhid="999" />
                </td>
                <td>3</td>
                <td>999</td>
            </tr>

            <tr>
                <td>
                    <input type="checkbox"
                           class="doc-checkbox"
                           data-docid="4"
                           data-hhid="888" />
                </td>
                <td>4</td>
                <td>888</td>
            </tr>

            <tr>
                <td>
                    <input type="checkbox"
                           class="doc-checkbox"
                           data-docid="5"
                           data-hhid="777" />
                </td>
                <td>5</td>
                <td>777</td>
            </tr>
        </tbody>
    </table>

    <button type="submit"
            asp-page-handler="AddDoc"
            class="btn btn-primary">
        Submit
    </button>

</form>


@section Scripts {

<script>

    // ============================================================
    // SETTINGS
    // ============================================================

    const selectedDocumentsKey = "selectedDocuments";


    // ============================================================
    // PAGE LOAD
    // ============================================================

    $(document).ready(function () {

        // Read selections from localStorage
        const selectedDocuments =
            getSelectedDocuments();

        // Rebuild hidden fields
        updateSelectedDocumentInputs(
            selectedDocuments
        );

        // Restore checkbox state
        restoreCheckboxes(
            selectedDocuments
        );
    });


    // ============================================================
    // CHECKBOX CLICK
    // ============================================================

    $(document).on(
        "change",
        ".doc-checkbox",
        function () {

            const docId =
                Number($(this).data("docid"));

            const hhId =
                Number($(this).data("hhid"));

            if ($(this).is(":checked")) {

                addSelectedDocument(
                    docId,
                    hhId
                );

            }
            else {

                removeSelectedDocument(
                    docId
                );
            }
        }
    );


    // ============================================================
    // GET SELECTED DOCUMENTS
    // ============================================================

    function getSelectedDocuments() {

        const storedArray =
            localStorage.getItem(
                selectedDocumentsKey
            );

        if (!storedArray) {
            return [];
        }

        return JSON.parse(storedArray);
    }


    // ============================================================
    // ADD DOCUMENT
    // ============================================================

    function addSelectedDocument(
        docId,
        hhId
    ) {

        let selectedDocuments =
            getSelectedDocuments();

        // Check whether DocId already exists
        const alreadyExists =
            selectedDocuments.some(
                x => x.docId === docId
            );

        if (!alreadyExists) {

            selectedDocuments.push({
                docId: docId,
                hhId: hhId
            });
        }

        saveSelectedDocuments(
            selectedDocuments
        );
    }


    // ============================================================
    // REMOVE DOCUMENT
    // ============================================================

    function removeSelectedDocument(
        docId
    ) {

        let selectedDocuments =
            getSelectedDocuments();

        // Remove only the selected document.
        // HHId automatically stays if another
        // document is using the same HHId.
        selectedDocuments =
            selectedDocuments.filter(
                x => x.docId !== docId
            );

        saveSelectedDocuments(
            selectedDocuments
        );
    }


    // ============================================================
    // SAVE TO LOCAL STORAGE
    // ============================================================

    function saveSelectedDocuments(
        selectedDocuments
    ) {

        localStorage.setItem(
            selectedDocumentsKey,
            JSON.stringify(
                selectedDocuments
            )
        );

        // Rebuild Razor model-binding inputs
        updateSelectedDocumentInputs(
            selectedDocuments
        );
    }


    // ============================================================
    // CREATE HIDDEN INPUTS FOR ASP.NET MODEL BINDING
    // ============================================================

    function updateSelectedDocumentInputs(
        selectedDocuments
    ) {

        const container =
            $("#selectedDocumentsContainer");

        // Remove existing hidden inputs
        container.empty();


        selectedDocuments.forEach(
            (item, index) => {

                container.append(`

                    <input type="hidden"
                           name="SelectedDocuments[${index}].DocId"
                           value="${item.docId}" />

                    <input type="hidden"
                           name="SelectedDocuments[${index}].HHId"
                           value="${item.hhId}" />

                `);
            }
        );
    }


    // ============================================================
    // RESTORE CHECKBOXES FROM LOCAL STORAGE
    // ============================================================

    function restoreCheckboxes(
        selectedDocuments
    ) {

        $(".doc-checkbox").each(
            function () {

                const docId =
                    Number(
                        $(this).data("docid")
                    );

                const isSelected =
                    selectedDocuments.some(
                        x => x.docId === docId
                    );

                $(this).prop(
                    "checked",
                    isSelected
                );
            }
        );
    }

</script>

}
